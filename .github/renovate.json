{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>quokkify/renovate-presets//presets/base",
    "github>quokkify/renovate-presets//presets/github-actions/default",
    "github>quokkify/renovate-presets//presets/gradle/default"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep Q4J Maven Central coordinates in module documentation current",
      "managerFilePatterns": [
        "/^(?:common-utils|data-utils|integrations)/.+/README\\.md$/",
        "/^testng-extensions/README\\.md$/"
      ],
      "matchStrings": [
        "dev\\.quokkify:(?<depName>q4j-[a-z0-9-]+):(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "maven",
      "packageNameTemplate": "dev.quokkify:{{{depName}}}",
      "registryUrlTemplate": "https://repo.maven.apache.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Keep the Selenium dynamic Chromium image tag current",
      "managerFilePatterns": [
        "/^tools/environment/assets/selenium-grid/config\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>selenium/standalone-chromium) currentValue=\\d+\\.\\d+(?:\\.\\d+)?-\\d+ currentDigest=(?<currentDigest>sha256:[a-f0-9]{64})[\\s\\S]*?configs\\s*=\\s*\\[\\s*\"selenium/standalone-chromium:(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?-\\d+)\""
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "selenium/standalone-chromium",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Keep the BusyBox CI helper image current",
      "managerFilePatterns": [
        "/^tools\\/environment\\/scripts\\/infra\\/modules\\/selenium\\/run_selenium_grid\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=busybox[\\s\\S]*?busybox:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "busybox"
    },
    {
      "customType": "regex",
      "description": "Keep curl CI helper images current",
      "managerFilePatterns": [
        "/^tools\\/environment\\/scripts\\/infra\\/modules\\/(?:mock\\/(?:run_mock_server|upload_expectations)|selenium\\/run_selenium_grid)\\.sh$/"
      ],
      "matchStrings": [
        "curlimages/curl:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "curlimages/curl"
    }
  ],
  "packageRules": [
    {
      "description": "Update all Q4J module documentation examples together",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["maven"],
      "matchPackageNames": ["/^dev\\.quokkify:q4j-/"],
      "groupName": "Q4J module documentation",
      "groupSlug": "q4j-module-documentation"
    },
    {
      "description": "Keep standalone-chromium on the custom Selenium regex manager only",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["selenium/standalone-chromium"],
      "enabled": false
    },
    {
      "description": "Update dated Selenium Grid and Chromium image tags together",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "selenium/hub",
        "selenium/node-docker",
        "selenium/standalone-chromium"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-(?<build>\\d+)$",
      "groupName": "selenium grid images",
      "groupSlug": "selenium-grid-images",
      "dependencyDashboardApproval": true
    }
  ]
}
