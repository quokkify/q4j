# shellcheck shell=bash disable=SC2034
# Pinned tool versions for the selenide-flutter device environment.
# Sourced by bash scripts and CI; the Flutter SDK version is pinned in
# integrations/selenide-flutter/test-app/pubspec.yaml (environment.flutter).
APPIUM_VERSION=3.9.1
UIAUTOMATOR2_DRIVER_VERSION=8.7.3
FLUTTER_INTEGRATION_DRIVER_VERSION=2.0.3
ANDROID_API_LEVEL=34
ANDROID_NDK_VERSION=28.2.13676358
case "$(uname -m)" in
  arm64 | aarch64) ANDROID_ABI=arm64-v8a ;;
  *) ANDROID_ABI=x86_64 ;;
esac
ANDROID_SYSTEM_IMAGE="system-images;android-${ANDROID_API_LEVEL};google_apis;${ANDROID_ABI}"
AVD_NAME=q4j-flutter
